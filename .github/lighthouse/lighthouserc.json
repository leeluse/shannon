{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/"
      ],
      "numberOfRuns": 1,
      "startServerCommand": "yarn --cwd client start -p 3000",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 120000,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa"
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
