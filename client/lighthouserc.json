{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "startServerCommand": "bun run start",
      "url": [
        "http://localhost:3000/"
      ],
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
